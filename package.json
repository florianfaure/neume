{
  "name": "neume",
  "private": true,
  "description": "Neume — a pixel icon set.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node scripts/smoke.mjs",
    "sheet": "npm run check && node scripts/sheet.mjs",
    "version": "node scripts/version.mjs"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
