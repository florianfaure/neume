{
  "name": "neume-site",
  "version": "0.1.0",
  "private": true,
  "description": "neume.dev — le site de Neume, export statique servi par un Worker Cloudflare.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "copies:check": "node scripts/copy-from-portfolio.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run test && npm run copies:check && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@neume-icons/react": "*",
    "@neume-icons/svg": "0.2.0",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  }
}
