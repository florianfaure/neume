# Cache immuable sur les fichiers hachés de Next : leur nom contient un hash de contenu, ils ne changent
# jamais sans changer de nom, donc les revalider est du gaspillage pur. C'est ce qui rend la deuxième
# visite gratuite, polices comprises.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Trois portes qui n'ont aucune raison d'être ouvertes. Le seul formulaire (la demande d'icône) poste au
# Worker, sur la même origine, et le seul tiers est le script Turnstile de Cloudflare. Pas de CSP : le script anti-flash du <head> est inline, et une CSP correcte
# imposerait de recalculer son hash à chaque build.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Les previews des branches (<branche>-neume-dev.<sous-domaine>.workers.dev) servent le même site que
# neume.dev : sans cet en-tête, un moteur pourrait les indexer comme des doublons. Un joker d'hôte ne
# traverse pas les points : la règle ne touche que workers.dev, jamais neume.dev.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Les données de navigation que Next exporte à côté de chaque page (index.txt, __next.*.txt) et la page
# /_not-found sont servies en 200 : sans cet en-tête, un moteur qui exécute la page peut les indexer.
# Une règle par chemin : pas de joker de suffixe, qui toucherait robots.txt.
/index.txt
  X-Robots-Tag: noindex
/docs.txt
  X-Robots-Tag: noindex
/changelog.txt
  X-Robots-Tag: noindex
/_not-found.txt
  X-Robots-Tag: noindex
/_not-found
  X-Robots-Tag: noindex
/_not-found/*
  X-Robots-Tag: noindex
/__next.*
  X-Robots-Tag: noindex
/docs/__next.*
  X-Robots-Tag: noindex
/changelog/__next.*
  X-Robots-Tag: noindex
